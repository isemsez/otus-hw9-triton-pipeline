name: "pipeline"
backend: "python"
max_batch_size: 0

input [
  {
    name: "TEXT"
    data_type: TYPE_STRING
    dims: [1]
  }
]

output [
  {
    name: "LABEL"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "PROBS"
    data_type: TYPE_FP32
    dims: [2]
  },
  {
    name: "ANSWER"
    data_type: TYPE_STRING
    dims: [1]
  }
]

instance_group [{ count: 1, kind: KIND_CPU }]
