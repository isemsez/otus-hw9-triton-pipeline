name: "text_classifier"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [-1, 384]
  }
]

output [
  {
    name: "label"
    data_type: TYPE_INT64
    dims: [-1]
  },
  {
    name: "probabilities"
    data_type: TYPE_FP32
    dims: [-1, 2]
  }
]

instance_group [{ count: 1, kind: KIND_CPU }]
